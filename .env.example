# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN VIETNAM TOURISM
# Đổi tên file này thành .env hoặc liên hệ tác giả để nhận file chuẩn
# ==========================================

# Cổng API Gateway
GATEWAY_PORT=6000

# URL các Microservices nội bộ
PROVINCE_SERVICE_URL=http://province-service:3001
LOCATION_SERVICE_URL=http://location-service:3002
MEDIA_SERVICE_URL=http://media-service:3003
PROVINCE_SERVICE_PORT=3001
LOCATION_SERVICE_PORT=3002
MEDIA_SERVICE_PORT=3003
NODE_ENV=production

# Google Gemini AI API Key (dùng cho AI Service)
GEMINI_API_KEY=your_gemini_api_key_here

# User Service & Authentication
PORT=3005
JWT_SECRET=your_jwt_secret_key_here

# Cấu hình gửi mail OTP xác thực (Google App Password)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Google OAuth Client ID (Frontend & Backend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
